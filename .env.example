# Career Toolkit — Environment Variables
# Copy this file to .env and fill in the values

# ─── Database (PostgreSQL) ───────────────────────────────────────────
# Vercel Postgres provides POSTGRES_URL automatically when you add the integration.
# For local development, use a local Postgres instance or Vercel's dev connection string.
POSTGRES_URL="postgresql://user:password@localhost:5432/career_toolkit"

# Legacy alias (optional, POSTGRES_URL takes priority)
# DATABASE_URL="postgresql://user:password@localhost:5432/career_toolkit"

# ─── OpenAI (LLM Extraction) ────────────────────────────────────────
# Required for LLM-powered job description parsing.
# Falls back to regex extraction if not set — app still works, just less accurate.
OPENAI_API_KEY="sk-..."

# ─── App Settings ────────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development/production)
# No additional app settings required at this time.

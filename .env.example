# Career Toolkit - Environment Variables
# Copy this file to .env and fill in the values

# --- Database (PostgreSQL via Neon) ---
# Primary connection URL for your private database.
POSTGRES_URL="postgresql://user:password@host:5432/career_toolkit"

# Demo database URL (required when DEMO_MODE=true).
# Must point to a DIFFERENT database than POSTGRES_URL to protect real data.
DEMO_DATABASE_URL="postgresql://user:password@host:5432/career_toolkit_demo"

# --- Demo Mode ---
# Set both to "true" to run the public demo deployment.
# Server-side: blocks mutations, mocks LLM calls, uses DEMO_DATABASE_URL.
DEMO_MODE="false"
# Client-side: shows "Demo Mode" banner in the UI.
NEXT_PUBLIC_DEMO_MODE="false"

# --- Authentication ---
# Bearer token for service endpoints (sentinel, integrity).
# When set, POST /api/sentinel and POST /api/integrity require this token.
SERVICE_TOKEN=""

# --- GC (Groundcrew) Auth ---
# Bearer token for Groundcrew command API routes (/api/gc/*).
# Required in production for GC command API auth. Without this, GC routes are
# inaccessible in production (fail closed). In development, routes are open.
GC_AUTH_TOKEN=""

# --- OpenAI (LLM) ---
# Required for LLM-powered job parsing, resume generation, and skill categorization.
# App degrades gracefully to regex/heuristic fallbacks without this key.
OPENAI_API_KEY="sk-..."

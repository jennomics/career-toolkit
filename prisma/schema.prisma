generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
// Schema version: 2 (Experience tables added)

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  url         String?
  description String
  status      String   @default("saved") // saved, applied, interviewing, offer, rejected, closed
  source      String?  // linkedin, company-site, referral, etc.
  notes       String?
  dreamCompany Boolean @default(false)
  dreamJob     Boolean @default(false)
  companyId   String?
  companyRef  Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills           JobSkill[]
  responsibilities JobResponsibility[]

  @@index([companyId])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  slug           String   @unique
  notes          String?
  dreamCompany   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([normalizedName])
}

model JobSkill {
  id             String  @id @default(cuid())
  name           String
  normalizedName String?
  category       String?
  jobId          String
  job            Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([name])
  @@index([normalizedName])
}

model JobResponsibility {
  id       String   @id @default(cuid())
  text     String
  category String   // responsibility, requirement, qualification
  keywords String[] // which skills/keywords this phrase relates to
  jobId    String
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Correction {
  id             String   @id @default(cuid())
  field          String   // "title", "company", "location"
  extractedValue String   // what the parser guessed
  correctedValue String   // what the user actually saved
  rawContext     String   // first ~500 chars of the raw text for pattern learning
  source         String?  // linkedin, company-site, etc.
  createdAt      DateTime @default(now())

  @@index([field])
}

model AgentCommand {
  id          String   @id @default(cuid())
  command     String   // shell command or action name
  description String?  // human-readable purpose
  status      String   @default("pending") // pending, running, success, failed
  stdout      String?  // command output
  stderr      String?  // error output
  exitCode    Int?
  duration    Int?     // ms
  source      String   @default("kiro") // who created it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── My Experience ───────────────────────────────────────────────────────────

model Experience {
  id             String   @id @default(cuid())
  title          String   // Job title / role
  company        String
  location       String?
  employmentType String   @default("full-time") // full-time, part-time, contract, freelance, internship
  industry       String?  // e.g. "Technology", "Healthcare"
  department     String?  // e.g. "Engineering", "Product"
  startDate      DateTime
  endDate        DateTime? // null = current role
  isCurrent      Boolean  @default(false)
  description    String?  // Summary / overview of the role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  skills     ExperienceSkill[]
  highlights ExperienceHighlight[]

  @@index([company])
  @@index([isCurrent])
}

model ExperienceSkill {
  id             String     @id @default(cuid())
  name           String     // Skill name — same conventions as JobSkill for cross-referencing
  normalizedName String?
  category       String?
  experienceId   String
  experience     Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([name])
  @@index([normalizedName])
}

model ExperienceHighlight {
  id           String     @id @default(cuid())
  text         String     // Achievement / bullet point (resume-ready)
  category     String     @default("achievement") // achievement, responsibility, project, award
  metrics      String?    // Quantified impact (e.g. "increased revenue 40%")
  keywords     String[]   // Related skills/keywords for matching
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

// ─── Resume Projects ─────────────────────────────────────────────────────────

model ResumeProject {
  id        String   @id @default(cuid())
  jobId     String   // Links to the target Job
  status    String   @default("draft") // draft, in-progress, complete
  step      Int      @default(1) // Current wizard step (1-4)

  // Step 2: Gap analysis results (cached)
  gapAnalysis Json? // { matched, gaps, realGaps, filledGaps }

  // Step 4: Selected highlights per role
  selectedHighlights Json? // [{ roleId, highlights: [{ text, edited, improved }] }]

  // Step 4: Generated resume content
  resumeContent Json?     // Structured resume sections
  resumeMarkdown String?  // Rendered resume text

  // Step 5: Cover letter
  coverLetterContent String? // Generated cover letter text

  // Metadata
  llmModel  String @default("gpt-4o")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

// ─── Skill Taxonomy ──────────────────────────────────────────────────────────

model SkillTaxonomy {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  category      String   // "Hard Skills" or "Soft Skills"
  subcategory   String   // e.g. "Programming Languages", "Leadership"
  aliases       String[] // known variant names
  createdAt     DateTime @default(now())
}

// ─── Candidate Profile ───────────────────────────────────────────────────────

model CandidateProfile {
  id                     String   @id @default(cuid())
  name                   String
  location               String?
  phone                  String?
  email                  String?
  linkedin               String?
  github                 String?
  currentTitle           String?
  reportsTo              String?
  positioningStatements  String[]
  selfDescribedStrengths String[]
  technicalInventory     String?
  educationCredentials   String?
  recognitionPresence    String?
  operatingPrinciples    String[]
  writingStyle           String?
  selfDescribedPosture   String?
  searchTargetLevel      String?
  searchGeography        String?
  searchCompanies        String[]
  searchFirms            String[]
  resumeOperatingRules   String[]
  knownGaps              String?
  personalBackground     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  careerRoles      CareerRole[]
  signatureStories SignatureStory[]
  profileMetrics   ProfileMetric[]
  unresolvedItems  UnresolvedItem[]
  writingSamples   WritingSample[]
}

model CareerRole {
  id           String   @id @default(cuid())
  profileId    String
  period       String
  organization String
  title        String
  scope        String?
  highlights   String[]
  sortOrder    Int
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model SignatureStory {
  id           String @id @default(cuid())
  profileId    String
  title        String
  situation    String
  obstacle     String
  action       String
  result       String
  whyItMatters String
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model ProfileMetric {
  id        String  @id @default(cuid())
  profileId String
  label     String
  value     String
  source    String?
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model UnresolvedItem {
  id          String    @id @default(cuid())
  profileId   String
  section     String
  description String
  optionA     String
  optionB     String
  resolution  String?
  resolvedAt  DateTime?
  priority    String
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model WritingSample {
  id        String   @id @default(cuid())
  profileId String
  title     String
  content   String
  context   String?
  createdAt DateTime @default(now())
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

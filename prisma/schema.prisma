generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  url         String?
  description String
  status      String   @default("saved") // saved, applied, interviewing, offer, rejected, closed
  source      String?  // linkedin, company-site, referral, etc.
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills JobSkill[]
}

model JobSkill {
  id    String @id @default(cuid())
  name  String
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([name])
}

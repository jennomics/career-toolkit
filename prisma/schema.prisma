generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
// Schema version: 2 (Experience tables added)

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  url         String?
  description String
  status      String   @default("saved") // saved, applied, interviewing, offer, rejected, closed
  source      String?  // linkedin, company-site, referral, etc.
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills           JobSkill[]
  responsibilities JobResponsibility[]
}

model JobSkill {
  id    String @id @default(cuid())
  name  String
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([name])
}

model JobResponsibility {
  id       String   @id @default(cuid())
  text     String
  category String   // responsibility, requirement, qualification
  keywords String[] // which skills/keywords this phrase relates to
  jobId    String
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Correction {
  id             String   @id @default(cuid())
  field          String   // "title", "company", "location"
  extractedValue String   // what the parser guessed
  correctedValue String   // what the user actually saved
  rawContext     String   // first ~500 chars of the raw text for pattern learning
  source         String?  // linkedin, company-site, etc.
  createdAt      DateTime @default(now())

  @@index([field])
}

model AgentCommand {
  id          String   @id @default(cuid())
  command     String   // shell command or action name
  description String?  // human-readable purpose
  status      String   @default("pending") // pending, running, success, failed
  stdout      String?  // command output
  stderr      String?  // error output
  exitCode    Int?
  duration    Int?     // ms
  source      String   @default("kiro") // who created it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── My Experience ───────────────────────────────────────────────────────────

model Experience {
  id             String   @id @default(cuid())
  title          String   // Job title / role
  company        String
  location       String?
  employmentType String   @default("full-time") // full-time, part-time, contract, freelance, internship
  industry       String?  // e.g. "Technology", "Healthcare"
  department     String?  // e.g. "Engineering", "Product"
  startDate      DateTime
  endDate        DateTime? // null = current role
  isCurrent      Boolean  @default(false)
  description    String?  // Summary / overview of the role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  skills     ExperienceSkill[]
  highlights ExperienceHighlight[]

  @@index([company])
  @@index([isCurrent])
}

model ExperienceSkill {
  id           String     @id @default(cuid())
  name         String     // Skill name — same conventions as JobSkill for cross-referencing
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([name])
}

model ExperienceHighlight {
  id           String     @id @default(cuid())
  text         String     // Achievement / bullet point (resume-ready)
  category     String     @default("achievement") // achievement, responsibility, project, award
  metrics      String?    // Quantified impact (e.g. "increased revenue 40%")
  keywords     String[]   // Related skills/keywords for matching
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}
